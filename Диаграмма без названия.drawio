        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam class {\n  BackgroundColor White\n  BorderColor Black\n  ArrowColor Black\n}\n\nclass Пайдаланушы {\n  +id : int\n  +аты : string\n  +рөлі : string\n  +логин : string\n  --\n  +кіру()\n  +рөлдіӨзгерту()\n}\n\nclass Клиент {\n  +id : int\n  +аты : string\n  +мекенжай : string\n  +телефон : string\n  --\n  +тапсырысБеру()\n  +статустыҚарау()\n}\n\nclass СүтҚабылдау {\n  +id : int\n  +жеткізуші : string\n  +көлем : float\n  +уақыт : datetime\n  +статус : string\n  --\n  +тіркеу()\n  +жаңарту()\n}\n\nclass ӨңдеуПроцесі {\n  +id : int\n  +кезең : string\n  +басталуУақыты : datetime\n  +аяқталуУақыты : datetime\n  +статус : string\n  --\n  +бастау()\n  +аяқтау()\n  +бақылау()\n}\n\nclass Тасымалдау {\n  +id : int\n  +көлік : string\n  +маршрут : string\n  +уақыт : datetime\n  +статус : string\n  +офлайнРежим : bool\n  --\n  +жоспарлау()\n  +офлайнЖоспарлау()\n  +бақылау()\n  +жеткізу()\n}\n\nclass ОфлайнМодуль {\n  +алдынАлаЖүктелгенКарта : string\n  +маршрутДеректері : string\n  +соңғыСинхрон : datetime\n  --\n  +офлайнРежимдіҚосу()\n  +деректердіСинхрондау()\n  +SMSЖіберу()\n}\n\nclass ДеректерБазасы {\n  --\n  +сақтау()\n  +іздеу()\n  +жаңарту()\n  +жою()\n  +офлайнДеректердіСақтау()\n}\n\nclass Есеп {\n  +id : int\n  +түрі : string\n  +күні : date\n  +деректер : string\n  --\n  +қалыптастыру()\n  +шығару()\n}\n\nclass Хабарлама {\n  +id : int\n  +мәтін : string\n  +алушы : string\n  +уақыт : datetime\n  +түрі : string  // SMS / жүйелік\n  --\n  +жіберу()\n  +SMSЖіберу()\n}\n\nПайдаланушы \&quot;1\&quot; --&gt; \&quot;*\&quot; СүтҚабылдау : тіркейді\nСүтҚабылдау \&quot;1\&quot; --&gt; \&quot;0..1\&quot; ӨңдеуПроцесі : жіберіледі\nӨңдеуПроцесі \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Тасымалдау : дайындалады\nКлиент \&quot;1\&quot; --&gt; \&quot;*\&quot; Тасымалдау : тапсырыс береді\n\nТасымалдау --&gt; ОфлайнМодуль : пайдаланады\nТасымалдау ..&gt; ДеректерБазасы\nСүтҚабылдау ..&gt; ДеректерБазасы\nӨңдеуПроцесі ..&gt; ДеректерБазасы\nОфлайнМодуль ..&gt; ДеректерБазасы\n\nДеректерБазасы --&gt; Есеп : қалыптастырады\nТасымалдау --&gt; Хабарлама : жібереді\nОфлайнМодуль --&gt; Хабарлама : SMS жібереді\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="s7bGMkm-CfpLOfcL7h2L-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
